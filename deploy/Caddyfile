# Serves a Unity WebGL build (Brotli-compressed) from /srv.
# Railway injects $PORT.
:{$PORT:8080} {
	root * /srv

	# Pre-compressed Unity output: tell the browser it's Brotli and give the real type.
	@br path *.br
	header @br Content-Encoding br
	header @br Vary Accept-Encoding

	@wasm path *.wasm *.wasm.br
	header @wasm Content-Type application/wasm

	@js path *.js.br
	header @js Content-Type application/javascript

	@data path *.data.br *.symbols.json.br
	header @data Content-Type application/octet-stream

	# Hashed build files can be cached hard; index.html must not be.
	@build path /Build/*
	header @build Cache-Control "public, max-age=31536000, immutable"
	@index path / /index.html
	header @index Cache-Control "no-cache"

	file_server
}
